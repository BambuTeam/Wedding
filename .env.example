# ==============================================================================
# AUREA - Environment Configuration
# ==============================================================================
# Nota: La plataforma opera automáticamente en MODO DEMO / IN-MEMORY FALLBACK
# si estas variables no están configuradas. Al agregar tus credenciales de AWS,
# se conectará en tiempo real a DynamoDB y S3 sin necesidad de tocar código.
# ==============================================================================

# AWS Credentials (Zero-Waste Serverless Stack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB Single-Table
DYNAMODB_TABLE_NAME=EventosPlatform

# S3 Bucket for Guest Media & Live Album
S3_BUCKET_NAME=aurea-wedding-media-production
S3_PUBLIC_DOMAIN=

# App Base URL (opcional para links de WhatsApp)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Evento por defecto
NEXT_PUBLIC_DEFAULT_EVENT_ID=camila-andres-2025
